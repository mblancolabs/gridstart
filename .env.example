# Environment Variables
# Copy this file to .env and modify as needed

# Server port (default: 5000)
# PORT=5000

# Environment mode (development/production)
# NODE_ENV=development

# CORS origin for development (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# WebSocket origin for development CSP. Defaults to CORS_ORIGIN converted to ws:
# DEV_CSP_WS_ORIGIN=ws://localhost:5173

# CSRF secret for stateless double-submit cookie CSRF protection
# CSRF_SECRET=your-super-secure-random-string-here-change-in-production

# Rate limiting configuration
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# EXPORT_RATE_LIMIT_WINDOW_MS=3600000
# EXPORT_RATE_LIMIT_MAX=10
# PREFERENCES_RATE_LIMIT_WINDOW_MS=300000
# PREFERENCES_RATE_LIMIT_MAX=20
# STATIC_RATE_LIMIT_WINDOW_MS=900000
# STATIC_RATE_LIMIT_MAX=1000

# GitHub sync: force-push main -> staging
# Requires gh CLI authenticated with repo scope.
# GITHUB_OWNER_REPO=mblancolabs/gridstart
# STAGING_RULESET_ID=17083082

# Cache provider selection
# Unset or "memory" to use in-memory cache (default, no dependencies)
# CACHE_PROVIDER=memory        # In-process memory (default, no deps)
# CACHE_PROVIDER=redis         # Redis via Upstash REST API (requires REDIS_URL + REDIS_TOKEN)
# CACHE_PROVIDER=kv            # Cloudflare KV (requires CACHE_KV binding in wrangler.toml)

# Redis credentials (required when CACHE_PROVIDER=redis)
# REDIS_URL=https://your-redis.upstash.io
# REDIS_TOKEN=your-token

# Cache TTL in seconds (default: 3600 = 1 hour)
# CACHE_TTL=3600
