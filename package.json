{
  "name": "gridstart",
  "version": "0.5.6",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "lint": "npm run check",
    "check": "tsc",
    "typecheck": "npm run check",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:client:a11y": "vitest run --config vitest.client.config.ts client/src/__tests__/components/**/*.a11y.test.tsx",
    "test:client:watch": "vitest --config vitest.client.config.ts",
    "test:client:coverage": "vitest run --coverage --config vitest.client.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:performance": "playwright test tests/e2e/performance.spec.ts",
    "db:push": "drizzle-kit push",
    "release:check": "npm pack --dry-run",
    "release:pack": "npm pack --pack-destination release"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
